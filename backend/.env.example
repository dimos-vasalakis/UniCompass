ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for legacy projects using the HS256 JWT secret.
# Leave empty to verify tokens via the project's JWKS (asymmetric signing keys).
SUPABASE_JWT_SECRET=

# Postgres (Supabase → Connect). Paste the URIs as-is; the app swaps in the psycopg driver.
# App runtime: transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Alembic migrations: direct connection (port 5432). IPv6-only on Supabase unless you buy the
# IPv4 add-on; if it won't connect, use the session pooler URI (same host as above, port 5432).
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PREMIUM_PRICE_ID=price_

# Resend
RESEND_API_KEY=re_
EMAIL_FROM=UniCompass <hello@yourdomain.gr>

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (optional; errors + tracing are off when empty)
SENTRY_DSN=

# Anthropic: Listing Check assistant (3 checks per account). Empty = assistant returns 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Google Routes API: only for scripts/compute_travel_times.py
GOOGLE_MAPS_API_KEY=
